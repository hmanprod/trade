# Admin
ADMIN_PASSWORD=changeme

# Telegram API (get from https://my.telegram.org/apps)
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=your_api_hash

# Database (Neon PostgreSQL — production)
# For local dev, use SQLite: sqlite+aiosqlite:///trade.db
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/trade?sslmode=require

# Session secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=your_session_secret_here

# Encryption key for Telegram session (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here
